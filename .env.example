# AI assistant settings for running locally with `npm start`.
# `npm install` copies this file to .env, which git ignores. Paste your key in .env, not here.
# This file is never used by the GitHub Pages site, where you paste your key into the app instead.
# Do not add a VITE_ prefix to these names: Vite would publish the value in the built site.

# anthropic, openai, or openai-compatible. Leave blank for anthropic.
AI_PROVIDER=

# Your own API key from that provider
AI_API_KEY=

# The model to use. Required unless the provider is anthropic, where blank means claude-opus-5-5.
AI_MODEL=

# Only for openai-compatible providers: the provider's API URL
AI_BASE_URL=
