{
  "name": "mockerrank",
  "version": "0.2.0",
  "private": true,
  "description": "Browser-only practice simulator for timed software engineering assessments.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-env.js && node scripts/copy-runtimes.js",
    "start": "npm run build && vite preview --port 8080 --strictPort",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:validate": "node scripts/validate-content.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:runners": "node --disable-warning=ExperimentalWarning scripts/test-runners.ts",
    "content:validate:browser": "node --disable-warning=ExperimentalWarning scripts/validate-browser.ts",
    "test:e2e": "npm run build && node --disable-warning=ExperimentalWarning scripts/test-e2e.ts"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/typography": "^0.5.20",
    "@yowasp/clang": "^22.0.0-git20542-10",
    "monaco-editor": "^0.57.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
